{
  "name": "ai-idea-council",
  "version": "1.0.0",
  "description": "AI Idea Council - Local Visual Multi-Agent Debate Arena",
  "private": true,
  "type": "module",
  "scripts": {
    "install": "npm-run-all install:*",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "dev": "npm-run-all dev:*",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm-run-all build:*",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "npm-run-all start:*",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start",
    "preview": "cd client && npm run preview",
    "lint": "oxlint . && cd server && npm run lint",
    "format": "prettier --write .",
    "test": "npm run test:client && npm run test:server",
    "test:client": "echo \"No client tests\"",
    "test:server": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.3.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=14.0.0"
  }
}